<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= product.name %> | <%= settings.siteName || "MyStore" %></title>
  <link rel="stylesheet" href="/css/detailedProduct.css" />

<style>
  :root {
    
    --primary: <%= settings.primaryColor %>; 
    --secondary: <%= settings.secondaryColor %>;
    --background: <%= settings.backgroundColor %>;
    --surface: <%= settings.surfaceColor %>;
    --text: <%= settings.textColor %>;
    --border: <%= settings.borderColor %>;
  }
</style>
</head>
<body>

<!-- HEADER -->
<header class="header">
    <div class="logo">
      <% if (settings.logo) { %>
        <img src="<%= settings.logo %>" style="height:30px;">
      <% } else { %>
        <%= settings.siteName || "MyStore" %>
      <% } %>
    </div>
  <nav>
    <a href="/">Shop More -></a>
  </nav>
</header>

<!-- PRODUCT -->
<main class="product-container">

  <!-- Floating Cart -->
  <a href="/cart" class="floating-cart">
    🛒
    <span id="floatingCartCount" class="floating-cart-count">0</span>
  </a>

  <!-- IMAGES -->
  <div class="product-images">
    <div class="image-zoom">
      <img id="mainProductImage" class="main-image" src="<%= product.images[0] %>" />
    </div>

    <div class="thumbnail-row">
      <% product.images.forEach((img, index) => { %>
        <img src="<%= img %>" class="thumbnail <%= index === 0 ? 'active' : '' %>" />
      <% }) %>
    </div>
  </div>

  <!-- INFO -->
  <div class="product-info">
    <h1><%= product.name %></h1>
    <p class="price">$<%= product.price.toFixed(2) %></p>

    <div class="rating">
      <% 
        const fullStars = Math.floor(product.rating);
        const emptyStars = 5 - fullStars;
      %>
      <%= '★'.repeat(fullStars) %><%= '☆'.repeat(emptyStars) %> (<%= product.reviews %> reviews)
    </div>

    <!-- DESCRIPTION -->
    <div class="description">
      <% product.description.split('||').forEach(line => { %>
        <p><%= line.trim() %></p>
      <% }) %>
    </div>

    <!-- OPTIONS -->
    <div class="product-options">

      <% 
        const options = product.options || {};
        const optionEntries = Object.entries(options);
      %>

      <% if (optionEntries.length > 0) { %>

        <% optionEntries.forEach(([key, values]) => { %>

          <% if (Array.isArray(values) && values.length > 0) { %>

            <div class="option-block">
              <p>Select <%= key.charAt(0).toUpperCase() + key.slice(1) %></p>

              <% values.forEach(val => { %>
                <button 
                  class="option-btn" 
                  data-type="<%= key %>" 
                  data-value="<%= val %>">
                  <%= val %>
                </button>
              <% }) %>

            </div>

          <% } %>

        <% }) %>

      <% } %>

    </div>
    <!-- Quantity -->
    <div class="quantity">
      <span>Qty:</span>
      <button id="decreaseQty">−</button>
      <input type="text" id="quantityInput" value="1" readonly />
      <button id="increaseQty">+</button>
    </div>

    <!-- Buttons -->
    <button class="add-to-cart" data-id="<%= product._id %>">Add to Cart</button>
    <button class="wishlist" data-id="<%= product._id %>">♡ Add to Wishlist</button>
  </div>

</main>

<!-- DETAILS -->
<section class="details">
  <h2>Product Details</h2>
  <ul>
    <% if (product.specs) { %>
      <% product.specs.split('|').forEach(spec => { 
           const [key, value] = spec.split(':'); %>
        <li><strong><%= key.trim() %>:</strong> <%= value.trim() %></li>
      <% }) %>
    <% } %>
  </ul>
</section>

<!-- RECOMMENDED -->
<section class="recommended">
  <h2>You may also like</h2>
  <div class="recommended-grid">
    <% recommended.forEach(r => { %>
      <div class="recommended-card">
        <a href="/product/<%= r._id %>">
          <img src="<%= r.images[0] %>" />
        </a>
        <h4><%= r.name %></h4>
        <p>$<%= r.price.toFixed(2) %></p>
        <button data-id="<%= r._id %>">Add to Cart</button>
      </div>
    <% }) %>
  </div>
</section>

<!-- SCRIPTS -->

<script src="/js/cartBadge.js"></script>
<script src="/js/detailedProduct.js"></script>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-container">

    <!-- BRAND -->
    <div class="footer-section">
      <h3><%= settings?.siteName || "MyStore" %></h3>
      <p><%= settings?.footerText || "Your one-stop shop for everything." %></p>
    </div>

    <!-- CONTACT -->
    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: <%= settings?.contactEmail || "support@email.com" %></p>
      <p>Phone: <%= settings?.contactPhone || "+233..." %></p>
    </div>

    <!-- LINKS -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <a href="/">Home</a>
      <a href="/cart">Cart</a>
      <a href="/dashboard">Account</a>
    </div>

  </div>

  <div class="footer-bottom">
    © <%= new Date().getFullYear() %> 
    <%= settings?.siteName || "MyStore" %> — All rights reserved.
  </div>
</footer>

</body>
</html>