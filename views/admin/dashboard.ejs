<%- include("../partials/header") %>

<section class="admin-dashboard">

  <div class="dashboard-header">
    <div>
      <h1>Admin Dashboard</h1>
      <p>Manage your website templates and products.</p>
    </div>
    <div>
      <h2>Nav Links</h2>
      <ul class="admin-nav">
        <li>
          <a href="/admin/campaign" class="admin-btn">
            + Add Campaign
          </a>
        </li>
        <li>
          <a href="/admin/add-product" class="admin-btn">
            + Add Product
          </a>
        </li>
      </ul>

    </div>

  </div>

<% if (!products || products.length === 0) { %>


<div class="empty-state">
  <h2>No Products Yet</h2>
  <p>You haven't added any products yet.</p>

  <a href="/admin/add-product" class="admin-btn">
    Add Your First Product
  </a>
</div>

<% } else { %>

<div class="products-table-wrapper">

  <table class="products-table">

    <thead>
      <tr>
        <th>Product</th>
        <th>Category</th>
        <th>Template</th>
        <th>Pricing</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>

      <% products.forEach(product => { %>

        <tr>

          <!-- Product -->
          <td>
            <div class="product-info">

              <% if (product.media?.image) { %>
                <img
                  src="<%= product.media.image %>"
                  alt="<%= product.name %>"
                  class="product-image"
                />
              <% } %>

              <div>
                <strong>
                  <%= product.name %>
                </strong>

                <small>
                  <%= product.slug %>
                </small>
              </div>

            </div>
          </td>

          <!-- Category -->
          <td>
            <%= product.category %>
          </td>

          <!-- Template -->
          <td>

            <% if (product.templatePath) { %>

              <code>
                <%= product.templatePath %>
              </code>

              <small class="template-location">
                storage/templates/<%= product.templatePath %>
              </small>

            <% } else { %>

              <span class="missing-template">
                Not configured
              </span>

            <% } %>

          </td>

          <!-- Pricing -->
          <td>

            <div class="pricing-info">
              <span>
                Source: $<%= product.pricing?.sourceCode ?? 0 %>
              </span>

              <span>
                Assisted: $<%= product.pricing?.assistedSetup ?? 0 %>
              </span>

              <span>
                Done: $<%= product.pricing?.doneForYou ?? 0 %>
              </span>
            </div>

          </td>

          <!-- Status -->
          <td>

            <% if (product.isActive) { %>

              <span class="status active">
                Active
              </span>

            <% } else { %>

              <span class="status inactive">
                Inactive
              </span>

            <% } %>

          </td>

          <!-- Actions -->
          <td>

            <div class="product-actions">

              <a
                href="/admin/edit-product/<%= product._id %>"
                class="admin-btn edit-btn"
              >
                Edit
              </a>

              <form
                action="/admin/delete-product/<%= product._id %>"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this product?');"
              >

                <button
                  type="submit"
                  class="admin-btn delete-btn"
                >
                  Delete
                </button>

              </form>

            </div>

          </td>

        </tr>

      <% }) %>

    </tbody>

  </table>

</div>


<% } %>

</section>

<style>

  .admin-dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 30px 20px;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
  }

  .dashboard-header h1 {
    margin: 0 0 6px;
  }

  .dashboard-header p {
    margin: 0;
    opacity: 0.7;
  }

  .admin-btn {
    display: inline-block;
    padding: 10px 16px;
    border-radius: 6px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
  }

  .products-table-wrapper {
    width: 100%;
    overflow-x: auto;
  }

  .products-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
  }

  .products-table th,
  .products-table td {
    padding: 14px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid rgba(128, 128, 128, 0.25);
  }

  .products-table th {
    font-size: 13px;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .product-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .product-info strong {
    display: block;
    margin-bottom: 4px;
  }

  .product-info small {
    display: block;
    opacity: 0.6;
  }

  .product-image {
    width: 55px;
    height: 55px;
    object-fit: cover;
    border-radius: 6px;
  }

  .template-location {
    display: block;
    margin-top: 5px;
    font-size: 11px;
    opacity: 0.6;
  }

  .missing-template {
    font-size: 13px;
    opacity: 0.6;
  }

  .pricing-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
  }

  .status {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }

  .status.active {
    background: rgba(0, 180, 80, 0.15);
  }

  .status.inactive {
    background: rgba(180, 0, 0, 0.15);
  }

  .product-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-actions form {
    margin: 0;
  }

  .edit-btn {
    background: #2563eb;
    color: white;
  }

  .delete-btn {
    background: #dc2626;
    color: white;
  }

  .empty-state {
    text-align: center;
    padding: 70px 20px;
    border: 1px dashed rgba(128, 128, 128, 0.4);
    border-radius: 10px;
  }

  .empty-state h2 {
    margin-bottom: 10px;
  }

  .empty-state p {
    opacity: 0.7;
    margin-bottom: 20px;
  }

  @media (max-width: 700px) {

    .dashboard-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .dashboard-header .admin-btn {
      width: 100%;
      text-align: center;
    }

  }

</style>

<%- include("../partials/footer") %>
