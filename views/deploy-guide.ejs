<%- include("partials/header") %>

<style>
.guide-page {
  max-width: 900px;
  margin: 40px auto;
  padding: 20px;
}

.guide-card {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 20px;
}

.guide-step {
 display: none; /* hide all steps by default */
}

.guide-step.active {
  display: block; /* only active step shows */
}

.step-nav {
  display: flex;
  justify-content: space-between;
  margin-top: 20px;
}

.guide-step:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.guide-step h3 {
  margin-bottom: 10px;
}

.guide-step p {
  margin-bottom: 10px;
  line-height: 1.6;
}

.guide-actions {
  margin-top: 10px;
}

.guide-actions .btn {
  margin-right: 10px;
  margin-bottom: 10px;
}

.code-box {
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 12px;
  margin-top: 10px;
  font-family: monospace;
  word-break: break-all;
}

.success-banner {
  background: #ecfdf5;
  border: 1px solid #10b981;
  color: #065f46;
  border-radius: 10px;
  padding: 15px;
  margin-bottom: 20px;
}
</style>

<section class="guide-page">

  <h1><%= product.name %> Deployment Guide</h1>

  <div class="success-banner">
    ✅ Your template source code has been uploaded successfully.
    You can now deploy it on Render.
  </div>

  <div class="guide-card">

    <div class="step-nav">
        <button class="btn" id="prevBtn">⬅ Back</button>
        <button class="btn primary" id="nextBtn">Next ➡</button>
    </div>

    <div class="guide-step active">

      <h3>Step 1: Create a Render Account</h3>

      <p>
        If you don't already have a Render account,
        create one before continuing or skip this step.
      </p>

      <div class="guide-actions">

        <a
          href="https://render.com/register"
          target="_blank"
          class="btn primary"
        >
          Create Render Account
        </a>


      </div>

    </div>

    <div class="guide-step">

      <h3>Step 2: Open Render Dashboard</h3>

      <p>
        Sign in and open your Render dashboard.
      </p>

      <div class="guide-actions">

        <a
          href="https://dashboard.render.com"
          target="_blank"
          class="btn"
        >
          Open Render Dashboard
        </a>

      </div>

    </div>

    <div class="guide-step">

      <h3>Step 3: Create a New Web Service</h3>

      <p>
        In Render:
      </p>

      <ol>
        <li>Click <strong>New +</strong></li>
        <li>Select <strong>Web Service</strong></li>
        <li>Connect GitHub if prompted</li>
      </ol>

    </div>


<div class="guide-step">

  <h3>Step 4: Select Your Repository</h3>

  <p>
    In Render, select the private GitHub repository
    created for your purchased template.
  </p>

  <% if (githubRepoUrl) { %>

    <div class="success-box">

      <h4>✅ Your Repository</h4>

      <p>
        Select this repository in Render:
      </p>

      <div class="code-box">
        <%= githubRepoUrl %>
      </div>

      <div class="guide-actions">

        <a
          href="<%= githubRepoUrl %>"
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
        >
          🔗 View Repository
        </a>

      </div>

    </div>

    <hr>

    <h4>Repository not showing in Render?</h4>

    <p>
      If you cannot find the repository in Render's GitHub
      repository list, don't worry. This usually means Render
      has not been given access to that repository yet.
    </p>

    <ol>

      <li>
        Make sure you are signed into Render with the
        correct account.
      </li>

      <li>
        Make sure the GitHub account connected to Render
        is the same account that owns the repository.
      </li>

      <li>
        In Render, open the GitHub connection or repository
        access settings.
      </li>

      <li>
        Make sure Render has permission to access the repository.
      </li>

      <li>
        Return to the <strong>New Web Service</strong> page
        and refresh the repository list.
      </li>

    </ol>

    <div class="warning-box">

      <strong>⚠️ Important</strong>

      <p>
        The repository is private. Render must have permission
        to access it before it can appear in the repository list.
      </p>

    </div>

  <% } else { %>

    <div class="warning-box">

      <strong>⚠️ Repository information unavailable</strong>

      <p>
        We could not find your GitHub repository information.
        Please return to the deployment page and make sure
        your repository was created successfully.
      </p>

    </div>

  <% } %>

</div>



    <div class="guide-step">




      <h3>Step 5: Configure Build Settings</h3>
      <ul>
        <li>click web service</li>
        <li>choose github under source code</li>
        <li>authenticate github if prompted, select all repository and click install</li>
        <li>select your repository</li>
        <li>render will automatically detect the framework and fill in the details</li>
        <li> change the name if needed</li>
        <li> change the build and start commands if needed</li>
      </ul>
      <p>
        paste the following build and start commands if they are not already filled in
      </p>

    

      <div class="code-box">
        Build Command:<br>
        npm install && npm run build
      </div>

      <div class="code-box">
        Start Command:<br>
        npm start
      </div>

    </div>
    
    <div class="guide-step">

    <h3>🗄️ MongoDB Setup (Required)</h3>

    <p>
        Follow these steps carefully to create your MongoDB database and connection string.
    </p>

    <div class="guide-actions">

        <a href="https://account.mongodb.com/account/register"
        target="_blank"
        class="btn primary">
        🔥 Step 1: Create MongoDB Account
        </a>

    </div>

    <hr>

    <!-- STEP 1 -->
    <h4>🔥 Step 1: Create MongoDB Account</h4>
    <ul>
        <li>Click Get Started</li>
        <li>Continue with Google (fastest)</li>
        <li>Accept privacy terms</li>
        <li>Skip personalization</li>
    </ul>

    <hr>

    <!-- STEP 2 -->
    <h4>🧱 Step 2: Create Cluster</h4>
    <ul>
        <li>Click <b>Create Cluster</b></li>
        <li>Select <b>FREE (M0)</b></li>
        <li>Click <b>Create Deployment</b></li>
        <li>Wait 1–3 minutes for setup</li>
    </ul>

    <hr>

    <!-- STEP 3 -->
    <h4>👤 Step 3: Create Database User</h4>

    <div class="guide-actions">
        <a href="https://cloud.mongodb.com/security/database/users"
        target="_blank"
        class="btn">
        Open Database Users
        </a>
    </div>

    <ul>
        <li>Go to Database Access</li>
        <li>Click Create User</li>
        <li>Set username (auto or custom)</li>
        <li>Set password (SAVE IT)</li>
        <li>Click Create User</li>
    </ul>

    <hr>

    <!-- STEP 4 -->
    <h4>🌐 Step 4: Network Access</h4>

    <div class="guide-actions">
        <a href="https://cloud.mongodb.com/security/networking"
        target="_blank"
        class="btn">
        Open Network Settings
        </a>
    </div>

    <ul>
        <li>Click Add IP Address</li>
        <li>Select: <b>Allow Access From Anywhere (0.0.0.0/0)</b></li>
    </ul>

    <hr>

    <!-- STEP 5 -->
    <h4>🗃️ Step 5: Create Database</h4>

    <ul>
        <li>Open your cluster</li>
        <li>Click Browse Collections</li>
        <li>Click Create Database</li>
        <li>Database Name: <b>lazyshop</b></li>
        <li>Collection Name: <b>users</b></li>
        <li>Click Create</li>
    </ul>

    <hr>

    <!-- STEP 6 -->
    <h4>🔌 Step 6: Get Connection String</h4>

    <ul>
        <li>Click <b>Connect</b></li>
        <li>Select <b>Drivers</b></li>
        <li>Choose <b>Node.js</b></li>
        <li>Leave version default</li>
    </ul>

    <div class="code-box">
        mongodb+srv://codecarthub_db_user:&lt;db_password&gt;@cluster0.i9lxxj7.mongodb.net/?appName=Cluster0
    </div>

    <hr>

    <!-- STEP 7 -->
    <h4>🔐 Step 7: Fix Password in URL</h4>

    <ul>
        <li>Replace <b>&lt;db_password&gt;</b> with your actual password</li>
    </ul>

    <div class="code-box">
        mongodb+srv://codecarthub_db_user:MyStrongPassword123@cluster0.i9lxxj7.mongodb.net/lazyshop?retryWrites=true&w=majority
    </div>

    <hr>

    <!-- WARNING -->
    <div class="success-banner">

        ⚠️ <b>IMPORTANT</b><br><br>

        Never share your MongoDB password publicly.<br>
        Treat this like a secret key.

    </div>

    </div>

    <div class="guide-step">

  <h3>Step 5.2: Add Environment Variables</h3>

  <p>
    In Render, scroll to <strong>Environment Variables</strong> and add the following:
  </p>

  <div class="code-box">
    MONGODB_URI = your-mongodb-connection-string<br>
    ADMIN_EMAIL = your-admin-email<br>
    ADMIN_PASSWORD = your-secure-password<br>
    JWT_SECRET = any-long-random-string
  </div>

  <p>
    ⚠️ Without these, your application will not start.
  </p>

    </div>



    <div class="guide-step">

      <h3>Step 6: Deploy</h3>

      <p>
        Click <strong>Create Web Service</strong>.
      </p>

      <p>
        Render will build and deploy your application.
        This can take a few minutes.
      </p>

    </div>

    <div class="guide-step">

      <h3>🎉 Step 7: Go Live</h3>

      <p>
        After deployment completes,
        Render will provide a public URL.
      </p>

      <div class="code-box">
        https://your-app.onrender.com
      </div>

      <p>
        Your application is now live.
      </p>

    </div>

  </div>
<script>
  const steps = document.querySelectorAll(".guide-step");
  const nextBtn = document.getElementById("nextBtn");
  const prevBtn = document.getElementById("prevBtn");

  let currentStep = 0;

  function showStep(index) {
    steps.forEach((step, i) => {
      step.classList.toggle("active", i === index);
    });

    prevBtn.style.display = index === 0 ? "none" : "inline-block";
    nextBtn.textContent = index === steps.length - 1 ? "Finish 🎉" : "Next ➡";
  }

  nextBtn.addEventListener("click", () => {
    if (currentStep < steps.length - 1) {
      currentStep++;
      showStep(currentStep);
    } else {
      alert("Deployment guide completed 🎉");
    }
  });

  prevBtn.addEventListener("click", () => {
    if (currentStep > 0) {
      currentStep--;
      showStep(currentStep);
    }
  });

  // init
  showStep(currentStep);
</script>
</section>

<%- include("partials/footer") %>