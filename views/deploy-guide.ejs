<!--script to handle the generation of the MongoDB connection string and copying it to clipboard -->
<script>
  const generateMongoUriBtn =
    document.getElementById("generateMongoUriBtn");

  const mongoUriInput =
    document.getElementById("mongoUri");

  const mongoPasswordInput =
    document.getElementById("mongoPassword");

  const mongoDatabaseInput =
    document.getElementById("mongoDatabase");

  const mongoUriResult =
    document.getElementById("mongoUriResult");

  generateMongoUriBtn.addEventListener("click", () => {
    const templateUri =
      mongoUriInput.value.trim();

    const password =
      mongoPasswordInput.value;

    const database =
      mongoDatabaseInput.value.trim();

    if (!templateUri) {
      alert("Please paste your MongoDB connection string.");
      mongoUriInput.focus();
      return;
    }

    if (!password) {
      alert("Please enter your MongoDB password.");
      mongoPasswordInput.focus();
      return;
    }

    if (!database) {
      alert("Please enter a database name.");
      mongoDatabaseInput.focus();
      return;
    }

    try {
      const safeTemplateUri = templateUri.replace(
        "<db_password>",
        "PLACEHOLDER_PASSWORD"
      );

      const url = new URL(safeTemplateUri);


      url.password = password;

      url.pathname = `/${encodeURIComponent(database)}`;

      const finalMongoUri = url.toString();

      generatedMongoUri.value = finalMongoUri;
      mongoUriResult.style.display = "block";

    } catch (error) {
      alert(
        "The MongoDB connection string is not valid. " +
        "Please copy it again from MongoDB."
      );

      mongoUriInput.focus();
    }
  });
</script>
<!--script to handle copying the generated MongoDB connection string to clipboard -->
<script>
  const copyMongoUriBtn =
    document.getElementById("copyMongoUriBtn");

  const generatedMongoUri =
    document.getElementById("generatedMongoUri");

  copyMongoUriBtn.addEventListener("click", async () => {
    const mongoUri =
      generatedMongoUri.value.trim();

    if (!mongoUri) {
      return;
    }

    try {
      await navigator.clipboard.writeText(
        mongoUri
      );

      copyMongoUriBtn.textContent =
        "✅ Copied!";

      setTimeout(() => {
        copyMongoUriBtn.textContent =
          "📋 Copy MONGO_URI";
      }, 2000);

    } catch (error) {
      console.error(
        "Failed to copy MONGO_URI:",
        error
      );

      alert(
        "Unable to copy automatically. " +
        "Please copy the connection string manually."
      );
    }
  });
</script>
<!--script to handle the generation of secure secrets for JWT and Refresh Tokens -->
<script>
  function generateSecureSecret(length = 64) {
    const characters =
      "ABCDEFGHIJKLMNOPQRSTUVWXYZ" +
      "abcdefghijklmnopqrstuvwxyz" +
      "0123456789_-";
      

    const randomValues =
      new Uint32Array(length);

    crypto.getRandomValues(randomValues);

    let secret = "";

    for (let i = 0; i < length; i++) {
      secret += characters[
        randomValues[i] % characters.length
      ];
    }

    return secret;
  }

  const jwtSecret =
    document.getElementById("jwtSecret");

  const refreshTokenSecret =
    document.getElementById("refreshTokenSecret");

  const generateJwtSecretBtn =
    document.getElementById("generateJwtSecretBtn");

  const generateRefreshSecretBtn =
    document.getElementById(
      "generateRefreshSecretBtn"
    );

  function generateSecrets() {
    jwtSecret.value =
      generateSecureSecret();

    refreshTokenSecret.value =
      generateSecureSecret();
  }

  generateJwtSecretBtn.addEventListener(
    "click",
    () => {
      jwtSecret.value =
        generateSecureSecret();
    }
  );

  generateRefreshSecretBtn.addEventListener(
    "click",
    () => {
      refreshTokenSecret.value =
        generateSecureSecret();
    }
  );

  // Generate both automatically when
  // the step is loaded.
  generateSecrets();
</script>
<!--script to handle the multi-step navigation of the deployment guide -->
<script>
  (() => {

    const steps =
      document.querySelectorAll(".guide-step");

    const nextBtn =
      document.getElementById("nextBtn");

    const prevBtn =
      document.getElementById("prevBtn");

    const STORAGE_KEY =
      "deploymentGuideState";

    let currentStep = 0;


    /*
    * Fields that should survive
    * a page refresh during this session.
    *
    * We deliberately save only form values.
    * Buttons and temporary UI state are not saved here.
    */
    function getFields() {

      return document.querySelectorAll(
        "input, textarea, select"
      );

    }


    /*
    * Save the current guide state.
    */
    function saveGuideState() {

      const values = {};

      getFields().forEach(field => {

        if (!field.id && !field.name) {
          return;
        }

        const key =
          field.name ||
          field.id;

        values[key] =
          field.value;

      });


      const state = {

        currentStep,

        values

      };


      try {

        sessionStorage.setItem(
          STORAGE_KEY,
          JSON.stringify(state)
        );

      } catch (error) {

        console.error(
          "Unable to save deployment guide session:",
          error
        );

      }

    }


    /*
    * Restore the guide after refresh.
    */
    function restoreGuideState() {

      try {

        const saved =
          sessionStorage.getItem(
            STORAGE_KEY
          );

        if (!saved) {
          return;
        }


        const state =
          JSON.parse(saved);


        if (
          typeof state.currentStep === "number" &&
          state.currentStep >= 0 &&
          state.currentStep < steps.length
        ) {

          currentStep =
            state.currentStep;

        }


        if (state.values) {

          getFields().forEach(field => {

            const key =
              field.name ||
              field.id;

            if (
              key &&
              Object.prototype.hasOwnProperty.call(
                state.values,
                key
              )
            ) {

              field.value =
                state.values[key];

            }

          });

        }

      } catch (error) {

        console.error(
          "Unable to restore deployment guide session:",
          error
        );

      }

    }


    /*
    * Display one step.
    */
    function showStep(index) {

      steps.forEach((step, i) => {

        step.classList.toggle(
          "active",
          i === index
        );

      });


      prevBtn.style.display =
        index === 0
          ? "none"
          : "inline-block";


      nextBtn.textContent =
        index === steps.length - 1
          ? "Finish 🎉"
          : "Next ➡";


      /*
      * Keep Render environment values
      * synchronized after restoring a step.
      */
      if (
        typeof updateRenderEnvironmentValues ===
        "function"
      ) {

        updateRenderEnvironmentValues();

      }

    }


    /*
    * Save every input change.
    *
    * This means even if the user forgets
    * to click Next, their current values
    * are still protected from refresh.
    */
    document.addEventListener(
      "input",
      () => {

        saveGuideState();

      }
    );


    document.addEventListener(
      "change",
      () => {

        saveGuideState();

      }
    );


    /*
    * NEXT
    */
    nextBtn.addEventListener(
      "click",
      () => {

        /*
        * Save BEFORE moving to the next step.
        */
        saveGuideState();


        if (
          currentStep <
          steps.length - 1
        ) {

          currentStep++;

          saveGuideState();

          showStep(currentStep);

          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });

        } else {

          saveGuideState();

          alert(
            "Deployment guide completed 🎉"
          );

        }

      }
    );


    /*
    * BACK
    */
    prevBtn.addEventListener(
      "click",
      () => {

        saveGuideState();


        if (currentStep > 0) {

          currentStep--;

          saveGuideState();

          showStep(currentStep);

          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });

        }

      }
    );


    /*
    * Restore first.
    */
    restoreGuideState();


    /*
    * Then display the restored step.
    */
    showStep(currentStep);

  })();
</script>
<!--script to handle the generation and copying of Render environment variables -->
<script>
  function getEnvironmentValue(variableName) {
    const fieldMap = {
      MONGO_URI: "generatedMongoUri",

      JWT_SECRET: "jwtSecret",
      REFRESH_TOKEN_SECRET: "refreshTokenSecret",

      BREVO_API_KEY: "BREVO_API_KEY",
      EMAIL_SENDER: "EMAIL_SENDER",

      STRIPE_SECRET_KEY: "STRIPE_SECRET_KEY",
      STRIPE_PUBLISHABLE_KEY: "STRIPE_PUBLISHABLE_KEY",
      STRIPE_WEBHOOK_SECRET: "STRIPE_WEBHOOK_SECRET",

      PAYSTACK_PUBLIC_KEY: "PAYSTACK_PUBLIC_KEY",
      PAYSTACK_SECRET_KEY: "PAYSTACK_SECRET_KEY",

      IMAGEKIT_URL_ENDPOINT: "IMAGEKIT_URL_ENDPOINT",
      IMAGEKIT_PUBLIC_KEY: "IMAGEKIT_PUBLIC_KEY",
      IMAGEKIT_PRIVATE_KEY: "IMAGEKIT_PRIVATE_KEY",

      ADMIN_EMAIL: "ADMIN_EMAIL",
      ADMIN_PASSWORD: "ADMIN_PASSWORD",
      ADMIN_USERNAME: "ADMIN_USERNAME",
      ADMIN_FULLNAME: "ADMIN_FULLNAME",
      ADMIN_COUNTRY: "ADMIN_COUNTRY"
    };

    const fieldId = fieldMap[variableName];

    if (!fieldId) {
      return "";
    }

    const field =
      document.getElementById(fieldId);

    return field
      ? field.value.trim()
      : "";
  }


  function updateRenderEnvironmentValues() {
    const renderFields =
      document.querySelectorAll(
        ".render-env-value"
      );

    renderFields.forEach((field) => {
      const variableName =
        field.dataset.variable;

      field.value =
        getEnvironmentValue(variableName);
    });
  }


  async function copyToClipboard(
    value,
    button,
    originalText
  ) {
    if (!value) {
      alert("There is no value to copy yet.");
      return;
    }

    try {
      await navigator.clipboard.writeText(value);

      button.textContent = "✅ Copied";
      button.dataset.copied = "true";

    } catch (error) {
      console.error(
        "Copy failed:",
        error
      );

      alert(
        "Unable to copy automatically. " +
        "Please copy it manually."
      );
    }
  }


  updateRenderEnvironmentValues();

  document.addEventListener(
    "input",
    () => {
      updateRenderEnvironmentValues();
    }
  );

  document.addEventListener(
    "click",
    () => {
      setTimeout(() => {
        updateRenderEnvironmentValues();
      }, 50);
    }
  );

  document
    .querySelectorAll(".copy-env-name")
    .forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const value =
            button.dataset.copy;

          copyToClipboard(
            value,
            button,
            "📋 Copy Name"
          );
        }
      );

    });

  document
    .querySelectorAll(".copy-env-value")
    .forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const variableName =
            button.dataset.variable;

          const value =
            getEnvironmentValue(
              variableName
            );

          copyToClipboard(
            value,
            button,
            "📋 Copy Value"
          );
        }
      );

    });
</script>

