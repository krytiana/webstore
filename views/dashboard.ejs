<%- include("partials/header") %>
  

  <link rel="stylesheet" href="/css/dashboard.css">

  <section class="dashboard">
    <div class="top-bar">
      <h1>Welcome, <%= user.username || user.email %></h1>
      <a href="/api/auth/logout" class="logout-btn" id="logout-btn">
        Logout
      </a>
    </div>
    
    <h4>Your Downloads</h4>

    <% if (downloads.length > 0) { %>

      <% downloads.forEach(download => { 
        const isExpired = new Date(download.expiresAt) < new Date();
        const canDownload = !isExpired && download.successfulDownloads < download.maxDownloads;
      %>

        <div class="card">
          <h2><%= download.product.name %></h2>

          <% if (download.product.media?.image) { %>
            <img src="<%= download.product.media.image %>" width="150">
          <% } %>

          <p><strong>Plan:</strong> <%= download.plan %></p>
          <p><strong>Downloads:</strong> <%= download.successfulDownloads %> / <%= download.maxDownloads %></p>
          <p><strong>Expires:</strong> <%= new Date(download.expiresAt).toLocaleString() %></p>

          <% if (canDownload) { %>
            <a href="<%= download.url %>" class="download-btn">Download</a>
            
          <% } else { %>
            <p class="blocked">
              Download not available.
            </p>
          <% } %>

        </div>

      <% }); %>

        <% } else { %>
          <p>No downloads found.</p>
        <% } %>


        <!-- ================================================== -->
        <!-- SERVICE ORDERS -->
        <!-- ================================================== -->

        
        <!-- ================================================== -->
<!-- SERVICE ORDERS -->
<!-- ================================================== -->

<h4>Your Services</h4>

<% if (serviceOrders.length > 0) { %>

  <% serviceOrders.forEach(order => { %>

    <div class="card">

      <h2>
        <%= order.product.name %>
      </h2>

      <% if (order.product.media?.image) { %>

        <img
          src="<%= order.product.media.image %>"
          width="150"
          alt="<%= order.product.name %>"
        >

      <% } %>

      <p>
        <strong>Plan:</strong>
        <%= order.plan %>
      </p>

      <p>
        <strong>Payment:</strong>
        <%= order.paymentStatus %>
      </p>

      <p>
        <strong>Status:</strong>
        <%= order.status %>
      </p>


      <!-- ============================================== -->
      <!-- ASSISTED SETUP -->
      <!-- ============================================== -->

      <% if (
        order.status === "pending" &&
        order.plan === "assistedSetup"
      ) { %>

        <p>
          Your assisted setup order has been received.
          You can continue from here.
        </p>

        <a
          href="/deploy/<%= order.product._id %>"
          class="deploy-btn"
        >
          Continue Setup
        </a>

      <% } %>


      <!-- ============================================== -->
      <!-- DONE FOR YOU -->
      <!-- ============================================== -->

      <% if (
        order.status === "pending" &&
        order.plan === "doneForYou"
      ) { %>

        <p>
          Your order has been received.
          Our team will handle the setup and deployment
          for you.
        </p>

        <p>
          <strong>Next step:</strong>
          Notify our team when you are ready for us to begin.
        </p>

        <button
          type="button"
          class="notify-admin-btn"
          data-order-id="<%= order._id %>"
        >
          Notify Admin
        </button>

      <% } %>


      <!-- ============================================== -->
      <!-- IN PROGRESS -->
      <!-- ============================================== -->

      <% if (order.status === "inProgress") { %>

        <p>
          Your service is currently in progress.
        </p>

      <% } %>


      <!-- ============================================== -->
      <!-- COMPLETED -->
      <!-- ============================================== -->

      <% if (order.status === "completed") { %>

        <p>
          Your service has been completed.
        </p>

      <% } %>

    </div>

  <% }); %>

<% } else { %>

  <p>No service orders found.</p>

<% } %>

  </section>

<script>

  const logoutBtn = document.getElementById("logout-btn");

    if (logoutBtn) {
      logoutBtn.addEventListener("click", () => {
        localStorage.removeItem("token");
        localStorage.removeItem("refreshToken");
      });
    }

document.querySelectorAll(".notify-admin-btn")
  .forEach(button => {

    button.addEventListener("click", async () => {

      const orderId =
        button.dataset.orderId;

      if (!orderId) {
        alert("Invalid service order.");
        return;
      }

      const originalText =
        button.textContent;

      button.disabled = true;
      button.textContent = "Sending...";

      try {

        const token =
          localStorage.getItem("token");

        const response =
          await fetch(
            "/service-orders/notify-admin",
            {
              method: "POST",

              headers: {
                "Content-Type": "application/json",
                ...(token
                  ? {
                      "Authorization":
                        `Bearer ${token}`
                    }
                  : {})
              },

              body: JSON.stringify({
                orderId
              })
            }
          );


        const data =
          await response.json();


        if (!response.ok || !data.success) {

          throw new Error(
            data.message ||
            "Failed to notify admin."
          );

        }


        button.textContent =
          "Admin Notified";

        alert(
          "Admin has been notified successfully."
        );


      } catch (error) {

        console.error(
          "Notify admin error:",
          error
        );

        alert(
          error.message ||
          "Unable to notify admin."
        );

        button.disabled = false;
        button.textContent =
          originalText;

      }

    });

  });

</script>

  <%- include("partials/footer") %>
