<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CodeCartHub</title>
<link rel="stylesheet" href="/css/home.css" />
</head>
<body>
  <%- include("partials/header") %>
<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <span class="badge">🚀 Production Ready Website Solutions</span>

        <h1>Launch Your Business Faster</h1>

        <p>
            Professional website solutions with full source code,
            admin dashboards, AI assistance, GitHub deployment,
            and everything you need to go live.
        </p>

        <div class="hero-buttons">
            <a href="/products" class="btn-primary">View All Websites</a>
            <a href="/chat" class="btn-secondary">Customize New Website </a>
        </div>

        <div class="hero-highlights">
            <span>✔ One-Time Payment</span>
            <span>✔ Full Source Code Ownership</span>
            <span>✔ One-Click Deployment</span>
            <span>✔ 24/7 AI Support</span>
            <span>✔ Live Demo Previews of What You Get</span>
        </div>
    </div>
</section>

<!-- INTRO -->
<section class="intro">
    <div class="container">
        <h2>Ready-to-Launch Website Solutions</h2>

        <p>
            Skip months of development and launch with professionally built
            websites designed for real businesses.
        </p>

        <p>
            Every template includes a complete frontend, backend,
            admin dashboard, deployment resources, and long-term
            flexibility to grow with your business.
        </p>
    </div>
</section>

<!-- FEATURES -->
<section class="features">
    <div class="container">

        <h2>Why Businesses Choose CodeCartHub</h2>

        <div class="feature-grid">

            <div class="feature-card">
                <h3>🚀 One-Click Deployment</h3>
                <p>
                    Deploy faster with our guided GitHub workflow.
                    Create a repository, upload your template,
                    configure services, and launch.
                </p>
            </div>

            <div class="feature-card">
                <h3>⚙️ Powerful Admin Settings</h3>
                <p>
                    Manage branding, logos, colors, hero images,
                    contact details, and content without coding.
                </p>
            </div>

            <div class="feature-card">
                <h3>🔄 One-Click GitHub Clone</h3>
                <p>
                    Create a private repository and securely transfer
                    purchased templates directly to GitHub.
                </p>
            </div>

            <div class="feature-card">
                <h3>🤖 24/7 AI Website Consultant</h3>
                <p>
                    Compare templates, receive deployment guidance,
                    and discuss custom website requirements.
                </p>
                <button class="btn-secondary" onclick="window.location.href='/chat'">
                    Talk to AI Consultant
                </button>
            </div>

            <div class="feature-card">
                <h3>🌐 Scalable & Business Ready</h3>
                <p>
                    Responsive design, secure authentication,
                    SEO-friendly architecture, and scalable backend.
                </p>
            </div>

            <div class="feature-card">
                <h3>💸 No Expensive Subscriptions</h3>
                <p>
                    Launch with minimal operating costs using services
                    that provide generous free plans.
                </p>
            </div>

        </div>

    </div>
</section>

<!-- HOW IT WORKS -->
<section class="process">
    <div class="container">

        <h2>How It Works</h2>

        <div class="steps">

            <div class="step">
                <span>1</span>
                <h3>Choose a Website Solution</h3>
                <p>Browse professionally built websites.</p>
            </div>

            <div class="step">
                <span>2</span>
                <h3>Purchase & Connect GitHub</h3>
                <p>Secure your purchase and connect GitHub.</p>
            </div>

            <div class="step">
                <span>3</span>
                <h3>Create Repository</h3>
                <p>Transfer source code to your private repository.</p>
            </div>

            <div class="step">
                <span>4</span>
                <h3>Follow Deployment Guide</h3>
                <p>Configure services and database.</p>
            </div>

            <div class="step">
                <span>5</span>
                <h3>Launch Your Business</h3>
                <p>Connect your domain and go live.</p>
            </div>

            <div class="step">
                <span>5</span>
                <h3>With Zero Effort</h3>
                <p>All Handled By CODE CARTHUB.</p>
            </div>

        </div>

        <button class="btn-primary" onclick="window.location.href='/products'">
            Get Started
        </button>

    </div>
</section>

<!-- BUILT FOR -->
<section class="built-for">
    <div class="container">

        <h2>Built For</h2>

        <div class="audience">
            <span>✔ Entrepreneurs</span>
            <span>✔ Small Businesses</span>
            <span>✔ Startups</span>
            <span>✔ Agencies</span>
            <span>✔ Freelancers</span>
            <span>✔ Growing Online Brands</span>
        </div>

    </div>
</section>

<!-- CTA -->
<section class="cta">
    <div class="container">

        <h2>Start Building Today</h2>

        <p>
            Launch faster with production-ready website solutions
            built for growth.
        </p>

        <a href="/products" class="btn-primary">
            View All Websites
        </a>

    </div>
</section>

<%- include("partials/footer") %>
</body>
</html>