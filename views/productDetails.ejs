
<%- include("partials/header") %>

<link rel="stylesheet" href="/css/colors.css" />

<!-- =========================================================
     PRODUCT HERO
========================================================= -->

<section class="product-hero" data-aos="fade-up">

  <div class="hero-text">

    <h1><%= product.name %></h1>

    <div class="hero-image">
      <img
        src="<%= product.media.image %>"
        alt="<%= product.name %> website template preview"
        loading="eager"
        decoding="async"
      />
    </div>

    <p class="tagline">
      A complete business website with admin dashboard and database integration.
    </p>

    <p class="starting-price">
      Plans starting from
      <strong>$<%= product.pricing.sourceCode %></strong>
    </p>

    <div class="hero-actions">

      <a href="#pricing" class="btn primary">
        View Pricing
      </a>

      <% if (product.media.demoUrl) { %>
        <a
          href="<%= product.media.demoUrl %>"
          target="_blank"
          rel="noopener noreferrer"
          class="btn outline"
        >
          Live Demo
        </a>
      <% } %>

    </div>

  </div>

</section>


<!-- =========================================================
     DEMO NOTE
========================================================= -->

<section class="demo-note" aria-label="Demo information">

  <span class="demo-icon" aria-hidden="true">🔍</span>

  <strong>Live demo shows the frontend only.</strong>

  <span>
    Backend, admin dashboard, database integration, and authentication
    are included in the purchased package.
  </span>

</section>


<!-- =========================================================
     PRODUCT OVERVIEW
========================================================= -->

<section class="overview">

  <h2>Product Overview</h2>

  <div
    class="product-description collapsed"
    id="desc"
    data-description="<%= JSON.stringify(product.description) %>"
    aria-live="polite"
  ></div>

  <button
    id="toggleDesc"
    class="read-more-btn"
    type="button"
    aria-expanded="false"
    aria-controls="desc"
  >
    Read More
  </button>

</section>


<!-- =========================================================
     WHAT'S INCLUDED
========================================================= -->

<section class="included">

  <h2>What's Included</h2>

  <div class="included-grid">

    <!-- FRONTEND -->

    <div
      class="box"
      data-aos="fade-up"
      data-aos-delay="150"
    >

      <h3>
        <span aria-hidden="true">🖥️</span>
        Frontend
      </h3>

      <ul>
        <% if (Array.isArray(product.features.frontend)) { %>

          <% product.features.frontend.forEach(item => { %>

            <li>
              <span class="feature-check" aria-hidden="true">✓</span>
              <span><%= item %></span>
            </li>

          <% }) %>

        <% } %>
      </ul>

    </div>


    <!-- BACKEND -->

    <div
      class="box"
      data-aos="fade-up"
      data-aos-delay="250"
    >

      <h3>
        <span aria-hidden="true">⚙️</span>
        Backend
      </h3>

      <ul>
        <% if (Array.isArray(product.features.backend)) { %>

          <% product.features.backend.forEach(item => { %>

            <li>
              <span class="feature-check" aria-hidden="true">✓</span>
              <span><%= item %></span>
            </li>

          <% }) %>

        <% } %>
      </ul>

    </div>

  </div>

</section>


<!-- =========================================================
     TECHNICAL STACK
========================================================= -->

<section class="tech">

  <h2>Technical Stack</h2>

  <ul class="tech-list">

    <% if (typeof product.features.techStack === "string") { %>

      <% product.features.techStack
        .split(",")
        .map(t => t.trim())
        .filter(Boolean)
        .forEach(t => { %>

          <li><%= t %></li>

      <% }) %>

    <% } else if (Array.isArray(product.features.techStack)) { %>

      <% product.features.techStack
        .filter(Boolean)
        .forEach(t => { %>

          <li><%= t %></li>

      <% }) %>

    <% } %>

  </ul>

</section>


<!-- =========================================================
     PRICING
========================================================= -->

<section
  id="pricing"
  class="pricing-section"
  aria-labelledby="pricing-title"
>

  <h2 id="pricing-title">Choose Your Setup Option</h2>

  <p class="pricing-intro">
    Choose the option that best fits how much of the technical setup
    you want to handle yourself.
  </p>


  <div
    class="pricing-cards"
    data-product="<%= product.slug %>"
  >


    <!-- =====================================================
         SOURCE CODE
    ====================================================== -->

    <div
      class="price-card"
      data-plan="sourceCode"
    >

      <h3>Basic Plan</h3>

      <p class="plan-description">
        Get the complete website files and set everything up yourself.
      </p>

      <p class="price">
        $<%= product.pricing.sourceCode %>
      </p>
      <p class="pbf">✔ Full Source Code</p>
      <p class="pbf">✔ Setup Guide (setup.md)</p>
      <p class="pbf">✔ Project Documentation (README.md)</p>
      <p class="pbf">✔ Lifetime Access</p>
      <p class="pls">❌ No support included</p>
      <p class="pls">❌ No installation help</p>

     

      <button
        type="button"
        class="btn choose-plan"
        data-plan-name="Source Code"
        aria-label="Choose Source Code plan"
      >
        Choose Source Code
      </button>

    </div>


    <!-- =====================================================
         ASSISTED SETUP
    ====================================================== -->

    <div
      class="price-card featured"
      data-plan="assistedSetup"
    >

      <span
        class="badge"
        aria-label="Recommended plan"
      >
        Most Popular
      </span>

      <h3>Assisted Setup</h3>

      <p class="plan-description">
        Get the complete website plus help getting it properly set up.
      </p>

      <p class="price">
        $<%= product.pricing.assistedSetup %>
      </p>

      <ul>

        <li>Everything in Source Code</li>
        <li>Installation assistance</li>
        <li>Database configuration</li>
        <li>Environment variable setup</li>
        <li>Help getting the website running</li>
        <li>Best for users who need technical help</li>

      </ul>

      <button
        type="button"
        class="btn choose-plan"
        data-plan-name="Assisted Setup"
        aria-label="Choose Assisted Setup plan"
      >
        Choose Assisted Setup
      </button>

    </div>


    <!-- =====================================================
         DONE FOR YOU
    ====================================================== -->

    <div
      class="price-card"
      data-plan="doneForYou"
    >

      <h3>Done For You</h3>

      <p class="plan-description">
        We handle the technical setup and deployment so your website
        is ready to use.
      </p>

      <p class="price">
        $<%= product.pricing.doneForYou %>
      </p>

      <ul>

        <li>Complete website source code</li>
        <li>Full installation and configuration</li>
        <li>Database setup</li>
        <li>Environment configuration</li>
        <li>Server deployment</li>
        <li>Ready-to-use website</li>

      </ul>

      <button
        type="button"
        class="btn choose-plan"
        data-plan-name="Done For You"
        aria-label="Choose Done For You plan"
      >
        Choose Done For You
      </button>

    </div>

  </div>

</section>


<!-- =========================================================
     WHO THIS IS FOR
========================================================= -->

<section class="audience">

  <h2>Who This Is For</h2>

  <ul>

    <li>Small businesses</li>
    <li>Startups</li>
    <li>Freelancers</li>
    <li>Developers and technical users</li>
    <li>Anyone looking for a ready-made website solution</li>

  </ul>

</section>


<!-- =========================================================
     PRODUCT DETAILS JAVASCRIPT
========================================================= -->

<script
  type="module"
  src="/js/product-details.js"
></script>


<%- include("partials/footer") %>
