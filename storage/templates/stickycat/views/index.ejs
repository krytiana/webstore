<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= settings.siteName || "Welcome to StickyCat" %></title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {

    /* Brand */
    --primary: <%= settings.primaryColor %>;
    --secondary: <%= settings.secondaryColor %>;

    /* Backgrounds */
    --background: <%= settings.backgroundColor %>;
    --surface: <%= settings.surfaceColor %>;
    --surfaceAlt: <%= settings.surfaceAltColor %>;

    /* Text */
    --heading: <%= settings.headingColor %>;
    --text: <%= settings.textColor %>;
    --muted: <%= settings.mutedTextColor %>;
    --interaction: <%= settings.interactionColor %>;

    /* Border */
    --border: <%= settings.borderColor %>;

  }
</style>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,sans-serif;background:var(--background);color:var(--heading)}

/* Header */
header{background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:1000}
.nav{max-width:1200px;margin:auto;padding:16px 24px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;font-size:20px;display: block}
.nav-right{display:flex;gap:10px}
input{padding:10px 12px;border-radius:12px;border:1px solid var(--border)}
button{border:none;border-radius:12px;padding:10px 14px;background:var(--primary);color:var(--interaction);cursor:pointer}
button.outline{background:var(--surface);color:var(--text);border:1px solid var(--border)}

/* Hero categories */
.hero-category{
  display:grid;
  grid-template-columns:2fr 3fr;
  gap:20px;
  align-items:center;
  margin:40px auto;
  max-width:1200px;
  padding:0 20px;
}
.hero-category img{
  width:100%;
  height:300px;
  object-fit:cover;
  border-radius:var(--radius);
  box-shadow:0 8px 20px var(--surfaceAlt);
}
.hero-category h2{font-size:28px;margin-bottom:10px}
.hero-category p{color:var(--muted);margin-bottom:12px}

.product-actions {
  position: sticky;
  top: 70px; /* height of your header */
  z-index: 999;
  background: var(--background);

}

.product-actions button{

  cursor:pointer;

}

/* Products */
.section-title{
  font-size:24px;
  font-weight:600;
  margin:20px;
}
.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
  margin:0 20px 40px;
}
.card{
  background:var(--surface);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:0 6px 18px var(--surfaceAlt);
  transition:.2s;
}
.card:hover{transform:translateY(-5px)}
.card img{width:100%;height:180px;object-fit:cover}
.card-body{padding:14px}
.price{font-size:14px;color:var(--muted);margin-top:4px}
.rating{font-size:13px;margin-top:4px}
.card-body button{width:100%;margin-top:10px}

/* Back button */
.back-btn{
  margin:20px;
  background:var(--surface);
  color:var(--primary);
  border:1px solid var(--heading);
  font-weight:bold;

}

/* Floating cart */
.floating-cart{
  position:fixed;
  bottom:20px;
  right:20px;
  background:var(--primary);
  color:var(--interaction);
  border:1px solid var(--border);
  width:55px;
  height:55px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  text-decoration:none;
  box-shadow:0 6px 20px var(--border);
  z-index:1000;
}

.floating-cart-count{
  position:absolute;
  top:-5px;
  right:-5px;
  background:red;
  color:white;
  font-size:12px;
  padding:2px 6px;
  border-radius:50%;
  min-width:18px;
  text-align:center;
  display:none;
}



/* FOOTER */

.footer{
  background:var(--surface);
  color:var(--text);
  padding:30px 20px 10px;
  margin-top:40px;
  border-top:1px solid var(--border);
}

.footer-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:20px;
}

.footer-section h3,
.footer-section h4{
  margin-bottom:10px;
  color:var(--heading);
}

.footer-section p{
  font-size:14px;
  margin-bottom:6px;
  color:var(--text);
}

.footer-section a{
  display:block;
  font-size:14px;
  color:var(--text);
  margin-bottom:6px;
}

.footer-section a:hover{
  color:var(--primary);
}

.footer-bottom{
  text-align:center;
  margin-top:20px;
  border-top:1px solid var(--border);
  padding-top:10px;
  font-size:13px;
  color:var(--muted);
}

@media(max-width:900px){
  .hero-category{grid-template-columns:1fr}
  .grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:520px){
  .grid{grid-template-columns:1fr}
  .nav { flex-direction: column; align-items: stretch; gap: 12px; }
  .logo { text-align: center; }
  .nav-right { width: 100%; display: flex; gap: 10px; }
  .nav-right input { flex: 1; }
}
</style>
</head>
<body>

<header>
  <div class="nav">
    <div>Welcome to <%= settings.siteName || "Welcome to ShopLite" %></div>
    <div class="nav-right">
      <input id="search" placeholder="Search…">
      <a href="/dashboard"><button class="outline">🧑</button></a>
    </div>
  </div>
</header>

<!-- HERO CATEGORIES -->
<div id="categoriesTop">

 <%
  const heroCategories = [
    ...new Set(
      products
        .map(p => p.category?.trim())
        .filter(Boolean)
    )
  ];
  %>
  <% heroCategories.forEach(cat => { %>

    <% const product = products.find(p => p.category === cat); %>

    <section class="hero-category">
      <img
        src="<%= product?.images?.[0] || '/images/placeholder.jpg' %>"
        alt="<%= cat %>"
      >

      <div>
        <h2><%= cat.charAt(0).toUpperCase() + cat.slice(1) %></h2>
        <p>Explore our <%= cat %> collection.</p>

        <button onclick="filterCategory('<%= cat %>')">
          Shop All <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
        </button>
      </div>
    </section>

  <% }) %>

</div>
  <div class="product-actions">
    <button class="back-btn" onclick="scrollToCategories()">
      ↑ Back to categories
    </button>

    <button class="back-btn" onclick="browseAllProducts()">
      🛍 Browse All Products
    </button>
  </div>
<!-- PRODUCTS -->
<div id="productsSection">

  <div class="section-title">Products</div>
  <div id="productGrid" class="grid"></div>
</div>

<a href="/cart" class="floating-cart">
  🛒
  <span id="floatingCartCount" class="floating-cart-count">0</span>
</a>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-container">

    <!-- BRAND -->
    <div class="footer-section">
      <h3><%= settings?.siteName || "MyStore" %></h3>
      <p><%= settings?.footerText || "Your one-stop shop for everything." %></p>
    </div>

    <!-- CONTACT -->
    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: <%= settings?.contactEmail || "support@email.com" %></p>
      <p>Phone: <%= settings?.contactPhone || "+233..." %></p>
    </div>

    <!-- LINKS -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <a href="/">Home</a>
      <a href="/cart">Cart</a>
      <a href="/dashboard">Account</a>
    </div>

  </div>

  <div class="footer-bottom">
    © <%= new Date().getFullYear() %> 
    <%= settings?.siteName || "MyStore" %> — All rights reserved.
  </div>
</footer>
<script src="/js/cartUtils.js" defer></script>
<script src="/js/cartBadge.js" defer></script>
<script>


/* ---------------- PRODUCTS ---------------- */
const grid = document.getElementById("productGrid");
const search = document.getElementById("search");
const productsSection = document.getElementById("productsSection");
const categoriesTop = document.getElementById("categoriesTop");

let current="all";

/* RENDER PRODUCTS */
function render(list){
  grid.innerHTML="";
  list.forEach(p=>{
    const card=document.createElement("div");
    card.className="card";
    card.innerHTML=`
      <img src="${p.images[0]}">
      <div class="card-body">
        <strong>${p.name}</strong>
        <div class="price">$${p.price}</div>
        <div class="rating">⭐ ${p.rating} (${p.reviews})</div>
        <a href="/product/${p._id}"><button>View Details</button></a>
      </div>
    `;
    card.querySelector("button").onclick=()=>addToCart(p);
    grid.appendChild(card);
  });
}

/* APPLY FILTERS AND SEARCH */
function apply(){
  const q = search.value.toLowerCase().trim();

  // Hide hero categories while typing
  if(q.length > 0){
    categoriesTop.style.display = "none";
    productsSection.style.display = "block";
  } else {
    categoriesTop.style.display = "block";
    productsSection.style.display = "block";
  }

  let list = products.filter(p=>p.name.toLowerCase().includes(q));
  if(current!=="all") list = list.filter(p=>p.category===current);

  render(list);
}

/* CATEGORY FILTER */
function filterCategory(cat){
  current = cat;
  apply();
  productsSection.scrollIntoView({behavior:"smooth"});
}

function browseAllProducts(){
  current = "all";
  search.value = "";
  render(products);
  productsSection.scrollIntoView({behavior:"smooth"});
}

function scrollToCategories(){
  categoriesTop.scrollIntoView({behavior:"smooth"});
}



/* INIT */
const products = <%- JSON.stringify(products) %>;
render(products);
search.addEventListener("input",apply);
</script>

</body>
</html>