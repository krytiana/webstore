<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= settings?.siteName || "MyStore" %></title>
<style>
  :root {

    /* Brand */
    --primary: <%= settings.primaryColor %>;
    --secondary: <%= settings.secondaryColor %>;

    /* Backgrounds */
    --background: <%= settings.backgroundColor %>;
    --surface: <%= settings.surfaceColor %>;
    --surfaceAlt: <%= settings.surfaceAltColor %>;

    /* Text */
    --heading: <%= settings.headingColor %>;
    --text: <%= settings.textColor %>;
    --muted: <%= settings.mutedTextColor %>;
    --interaction: <%= settings.interactionColor %>;

    /* Border */
    --border: <%= settings.borderColor %>;

  }
</style>
<style>
* { margin:0; padding:0; box-sizing:border-box; font-family:Arial; }
body {
  font-family: Inter, sans-serif;
  background:var(--surfaceAlt);
  color: var(--border);
}

/* HEADER */
.header{
  background: var(--primary);
  padding:15px;
  position:sticky;
  top:0;
  z-index:100;
}
.top-bar{
  display:flex;
  justify-content:space-between;
  margin-bottom:10px;
  color: var(--surface);
  font-size:14px;
}
.top-bar a{
  color:var(--surface);
  text-decoration:none;
  margin-left:10px;
}
.search-box{
  background:var(--surface);
  padding:12px 15px;
  border-radius:30px;
}
.search-box input{
  border:none;
  outline:none;
  width:100%;
  font-size:16px;
}

/* Categories */
.categories{
  display:flex;
  gap:20px;
  overflow-x:auto;
  padding:15px;
  background:var(--primary);

  position:sticky;
  top:105px;          /* height of your sticky header */
  z-index:99;

  border-bottom:1px solid var(--border);
}

.categories::-webkit-scrollbar{
  display:none;
}
.categories::-webkit-scrollbar{ display:none; }
.category-item{
  color:var(--surface);
  white-space:nowrap;
  font-size:14px;
  cursor:pointer;
  opacity:0.8;
}
.category-item.active{
  font-weight:bold;
  opacity:1;
  border-bottom:2px solid var(--surface);
}

/* =====================
   HERO
===================== */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.hero h1 {
  font-size: 42px;
  line-height: 1.1;
  
}

.hero p {
  margin-top: 12px;
  color: var(--muted);
}

.slides{
  position:relative;
  width:100%;
  aspect-ratio:16/8;
  overflow:hidden;
  border-radius:var(--radius);
  
}

.slide{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:contain;
    opacity:0;
    transition:opacity .8s;
}

.slide.active{
  opacity:1;
}


/* DELIVERY */
.delivery{
  background:var(--surface);
  padding:10px;
  display:flex;
  justify-content:space-between;
  font-size:14px;
  color:var(--text);
}

/* PRODUCT GRID */
.products{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  padding:10px;
}
.product-card{
  background:var(--surface);
  border-radius:8px;
  padding:8px;
  box-shadow: 0 10px 25px var(--surfaceAlt);
  overflow: hidden;
  transition: transform .2s ease, box-shadow .2s ease;
}

.product-card:hover{
  transform: translateY(-6px);
  box-shadow: 0 18px 40px var(--secondary);
}
.product-card img{
  width:100%;
  height:140px;
  object-fit:cover;
  border-radius:6px;
}
.product-link{
  text-decoration: none;
}
.title{
  font-size:14px;
  margin:6px 0;
  height:34px;
  overflow:hidden;
  color:var(--heading);
  font-weight:bold;
}
.price{
  color:var(--primary);
  font-weight:bold;
  font-size:14px;
}
.rating{
  font-size:12px;
  color:var(--muted);
}

.floating-cart{
  position:fixed;
  bottom:20px;
  right:20px;
  background:var(--primary);
  color:var(--interaction);
  border:1px solid var(--border);
  width:55px;
  height:55px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  text-decoration:none;
  box-shadow:0 6px 20px var(--border);
  z-index:1000;
}

.floating-cart-count{
  position:absolute;
  top:-5px;
  right:-5px;
  background:red;
  color:white;
  font-size:12px;
  padding:2px 6px;
  border-radius:50%;
  min-width:18px;
  text-align:center;
  display:none;
}
/* FOOTER */

.footer{
  background:var(--surface);
  color:var(--text);
  padding:30px 20px 10px;
  margin-top:40px;
  border-top:1px solid var(--border);
}

.footer-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:20px;
}

.footer-section h3,
.footer-section h4{
  margin-bottom:10px;
  color:var(--heading);
}

.footer-section p{
  font-size:14px;
  margin-bottom:6px;
  color:var(--text);
}

.footer-section a{
  display:block;
  font-size:14px;
  color:var(--text);
  margin-bottom:6px;
}

.footer-section a:hover{
  color:var(--primary);
}

.footer-bottom{
  text-align:center;
  margin-top:20px;
  border-top:1px solid var(--border);
  padding-top:10px;
  font-size:13px;
  color:var(--muted);
}

@media(max-width: 900px) {
  .hero { grid-template-columns: 1fr; }
  .hero-text { display: none; }
}

/* Desktop */
@media(min-width:768px){
  .products{
    grid-template-columns:repeat(4,1fr);
    .hero { grid-template-columns: 1fr; }
  }

  .hero {
  
  }
}

@media screen and (max-width:480px){
  .hero h1 { font-size: 22px; }
}
</style>
</head>
<body>

<div class="header">

  <div class="top-bar">
  <div class="logo">
      <h2><%= settings.siteName || "ShopLite" %></h2>
    </div>

    <div id="userSection">login</div>
  </div>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="Search products...">
  </div>

  

</div>

<a href="/cart" class="floating-cart">
  🛒
  <span id="floatingCartCount" class="floating-cart-count">0</span>
</a>

<section class="container hero" id="heroSection">
  <div class="hero-text">
    <h1>Welcome to <%= settings.siteName || "Welcome to ShopLite" %></h1>
    <p><%= settings.heroSubtitle || "Your one-stop shop for all your needs." %></p>
  </div>
    <div class="slides">
    <% if (settings.heroImages && settings.heroImages.length) { %>
      
      <% settings.heroImages.forEach((img, index) => { %>
          <img
              src="<%= img %>"
              class="slide <%= index === 0 ? 'active' : '' %>"
              alt="Hero"
          >
      <% }) %>

    <% } else { %>

      <!-- fallback (important) -->
      <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?q=80&w=1000" />

    <% } %>
  </div>
</section>
<div class="categories" id="categoryContainer"></div>
<div class="delivery">
  <div>🚚 Free Shipping</div>
  <div>🔒 Secure Payment</div>
</div>

<div class="products" id="productContainer">
  <% products.forEach(product => { %>
    <div class="product-card">
      <a href="/product/<%= product._id %>" class="product-link">
        <img src="<%= product.images[0] %>" alt="<%= product.name %>">
        <div class="title"><%= product.name %></div>
        <div class="price">$<%= product.price.toFixed(2) %></div>
        <div class="rating">⭐ <%= product.rating %> (<%= product.reviews %>)</div>
      </a>
    </div>
  <% }) %>
</div>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-container">

    <!-- BRAND -->
    <div class="footer-section">
      <h3><%= settings?.siteName || "MyStore" %></h3>
      <p><%= settings?.footerText || "Your one-stop shop for everything." %></p>
    </div>

    <!-- CONTACT -->
    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: <%= settings?.contactEmail || "support@email.com" %></p>
      <p>Phone: <%= settings?.contactPhone || "+233..." %></p>
    </div>

    <!-- LINKS -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <a href="/">Home</a>
      <a href="/cart">Cart</a>
      <a href="/dashboard">Account</a>
    </div>

  </div>

  <div class="footer-bottom">
    © <%= new Date().getFullYear() %> 
    <%= settings?.siteName || "MyStore" %> — All rights reserved.
  </div>
</footer>

<script src="/js/cartUtils.js" defer></script>
<script src="/js/cartBadge.js" defer></script>
<script type="module" src="/js/login.js"></script>

<script type="module">

  // HERO SLIDER  
let currentSlide=0;  
const slides=document.querySelectorAll('.slides img');  
const totalSlides=slides.length;  
function showSlide(index){slides.forEach((slide,i)=>slide.classList.toggle('active',i===index));}  

  window.nextSlide = function(){
  currentSlide = (currentSlide + 1) % totalSlides;
  showSlide(currentSlide);
}

window.prevSlide = function(){
  currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
  showSlide(currentSlide);
}
  
setInterval(nextSlide,5000);


const productContainer = document.getElementById("productContainer");
const categoryContainer = document.getElementById("categoryContainer");
const searchInput = document.getElementById("searchInput");

let currentCategory = "all";

// Convert EJS products into JS array
const products = <%- JSON.stringify(products) %>;

/* ========= RENDER PRODUCTS ========= */
function renderProducts(productList){
  productContainer.innerHTML = "";
  if(productList.length === 0){
    productContainer.innerHTML = "<p>No products found.</p>";
    return;
  }
  productList.forEach(product=>{
    const card = document.createElement("div");
    card.className = "product-card";
    card.innerHTML = `
    <a href="/product/${product._id}" class="product-link">
      <img src="${product.images[0]}" alt="${product.name}">
      <div class="title">${product.name}</div>
      <div class="price">$${product.price.toFixed(2)}</div>
      <div class="rating">⭐ ${product.rating} (${product.reviews})</div>
    </a>
    `;
    productContainer.appendChild(card);
  });
}

/* ========= GENERATE CATEGORIES ========= */
function generateCategories(){
  const categories = ["all", ...new Set(products.map(p=>p.category))];
  categories.forEach(cat=>{
    const div = document.createElement("div");
    div.className = "category-item";
    div.textContent = cat.toUpperCase();
    if(cat === "all") div.classList.add("active");
    div.addEventListener("click", ()=>{
      document.querySelectorAll(".category-item")
        .forEach(item=>item.classList.remove("active"));
      div.classList.add("active");
      currentCategory = cat;
      filterProducts();
    });
    categoryContainer.appendChild(div);
  });
}

/* ========= FILTER FUNCTION ========= */
function filterProducts(){
  let filtered = products;
  if(currentCategory !== "all"){
    filtered = filtered.filter(p=>p.category === currentCategory);
  }
  const searchValue = searchInput.value.toLowerCase();
  if(searchValue){
    filtered = filtered.filter(p =>
      p.name.toLowerCase().includes(searchValue)
    );
    //hide hero section if search is active
    document.getElementById("heroSection").style.display = "none";

  }
  renderProducts(filtered);
}

/* ========= SEARCH ========= */
searchInput.addEventListener("input", filterProducts);

/* ========= INIT ========= */
generateCategories();
renderProducts(products);

</script>
</body>
</html>