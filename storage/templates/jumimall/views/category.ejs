<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= settings.siteName || "MyStore" %></title>

<style>
:root {

  /* Brand */
  --primary: <%= settings.primaryColor %>;
  --secondary: <%= settings.secondaryColor %>;

  /* Backgrounds */
  --background: <%= settings.backgroundColor %>;
  --surface: <%= settings.surfaceColor %>;
  --surfaceAlt: <%= settings.surfaceAltColor %>;

  /* Text */
  --heading: <%= settings.headingColor %>;
  --text: <%= settings.textColor %>;
  --muted: <%= settings.mutedTextColor %>;
  --interaction: <%= settings.interactionColor %>;

  /* Border */
  --border: <%= settings.borderColor %>;

}
</style>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial;}
body{background:var(--background);}

.header{
  background:var(--surface);
  border-bottom:1px solid var(--border);
  backdrop-filter:blur(12px);
  padding:12px;
  position:sticky;
  top:0;
  z-index:100;
}

/* top navigation row */
.header nav{
  display:flex;
  justify-content:flex-end;
  margin-bottom:10px;
}

.header nav a{
  margin-left:20px;
  text-decoration:none;
  font-size:14px;
  transition:0.2s;
  color:var(--text);
}

.header nav a:hover{
  color:var(--primary);
}

/* search below nav */
.search-box{
  background:var(--surfaceAlt);
  border:1px solid var(--border);
  padding:10px 15px;
  border-radius:30px;
}

.search-box input{
  width:100%;
  border:none;
  outline:none;
  background:transparent;
  color:var(--text);
}

/* FLOATING CART */

.floating-cart{
  position:fixed;
  bottom:20px;
  right:20px;
  background:var(--primary);
  color:var(--interaction);
  border:1px solid var(--border);
  width:55px;
  height:55px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:24px;
  text-decoration:none;
  box-shadow:0 6px 20px var(--border);
  z-index:1000;
}

.floating-cart-count{
  position:absolute;
  top:-5px;
  right:-5px;
  background:red;
  color:white;
  font-size:12px;
  padding:2px 6px;
  border-radius:50%;
  min-width:18px;
  text-align:center;
  display:none;
}


.page-title{
    color:var(--heading);
    font-size:28px;
    font-weight:700;
    padding:30px 20px 10px;
}

.products-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  padding:10px;
}


.product-card{
    background:var(--surface);
    border:1px solid var(--border);
    box-shadow:none;
    transition:.25s;
    border-radius:8px;
    padding:8px;
    position:relative;
}

.product-card:hover{
    transform:translateY(-3px);
    border-color:var(--primary);
}

.product-card img{
  width:100%;
  height:150px;
  object-fit:cover;
  border-radius:6px;
}

.discount-badge{
  position:absolute;
  top:6px;
  left:6px;
  background:var(--secondary);
  color:var(--interaction);
  font-size:11px;
  padding:3px 6px;
  border-radius:4px;
}

.title{
  color:var(--heading);
  font-size:13px;
  margin:6px 0;
  height:32px;
  overflow:hidden;
}

.price{
    color:var(--primary);
    font-size:16px;
    font-weight:700;
}

.rating{
  font-size:12px;
  color:var(--muted);
}

.no-products{
  padding:20px;
  text-align:center;
}

/* ---------- FOOTER ---------- */

.footer{
  background:var(--surface);
  color:var(--text);
  padding:30px 20px 10px;
  margin-top:40px;
  border-top:1px solid var(--border);
}

.footer-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:20px;
}

.footer-section h3,
.footer-section h4{
  margin-bottom:10px;
  color:var(--heading);
}

.footer-section p{
  font-size:14px;
  margin-bottom:6px;
  color:var(--text);
}

.footer-section a{
  display:block;
  font-size:14px;
  color:var(--text);
  margin-bottom:6px;
}

.footer-section a:hover{
  color:var(--primary);
}

.footer-bottom{
  text-align:center;
  margin-top:20px;
  border-top:1px solid var(--border);
  padding-top:10px;
  font-size:13px;
  color:var(--muted);
}
@media(min-width:768px){
  .products-grid{
    grid-template-columns:repeat(4,1fr);
  }
}
</style>
</head>

<body>

<div class="header">
  <nav>
    <a href="/">Home</a>
    
    <a href="/dashboard">Dashboard</a>
  </nav>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="Search in category...">
  </div>
</div>

  <!-- Floating Cart -->
  <a href="/cart" class="floating-cart">
    🛒
    <span id="floatingCartCount" class="floating-cart-count">0</span>
  </a>

<div class="page-title" id="pageTitle"></div>
<div class="products-grid" id="productsGrid"></div>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-container">

    <!-- BRAND -->
    <div class="footer-section">
      <h3><%= settings?.siteName || "MyStore" %></h3>
      <p><%= settings?.footerText || "Your one-stop shop for everything." %></p>
    </div>

    <!-- CONTACT -->
    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: <%= settings?.contactEmail || "support@email.com" %></p>
      <p>Phone: <%= settings?.contactPhone || "+233..." %></p>
    </div>

    <!-- LINKS -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <a href="/">Home</a>
      <a href="/cart">Cart</a>
      <a href="/dashboard">Account</a>
    </div>

  </div>

  <div class="footer-bottom">
    © <%= new Date().getFullYear() %> 
    <%= settings?.siteName || "MyStore" %> — All rights reserved.
  </div>
</footer>
<script src="/js/cartBadge.js"></script>
<script src="/js/login.js" defer></script>

<!-- 🔥 INJECT DATA -->
<script>
  let products = <%- JSON.stringify(products) %>;
  const category = "<%= category %>";

  // Fix MongoDB id
  products.forEach(p => {
    p.id = p._id;
  });

  const pageTitle = document.getElementById("pageTitle");
  const productsGrid = document.getElementById("productsGrid");
  const searchInput = document.getElementById("searchInput");

  pageTitle.textContent = category.toUpperCase();

  /* ===== RENDER PRODUCTS ===== */
  function renderProducts(searchValue=""){
    
    let filtered = products.filter(p => p.category === category);

    if(searchValue){
      filtered = filtered.filter(p =>
        p.name.toLowerCase().includes(searchValue.toLowerCase())
      );
    }

    if(filtered.length === 0){
      productsGrid.innerHTML = `
        <div class="no-products">No products found.</div>
      `;
      return;
    }

    productsGrid.innerHTML = filtered.map(product=>`
      <div class="product-card">
        ${product.discount ? `<div class="discount-badge">-${product.discount}%</div>`:""}
        <a href="/product/${product.id}" style="text-decoration:none;color:black;">
          <img src="${product.images[0]}" alt="${product.name}">
          <div class="title">${product.name}</div>
          <div class="price">GH₵ ${product.price.toFixed(2)}</div>
          <div class="rating">⭐ ${product.rating} (${product.reviews})</div>
        </a>
      </div>
    `).join("");
  }

  renderProducts();

  /* ===== SEARCH ===== */
  searchInput.addEventListener("input", function(){
    renderProducts(this.value.trim());
  });

</script>

</body>
</html>