<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
 <title> <%= settings.siteName || "MyStore" %></title>
  <link rel="stylesheet" href="/css/cart.css" />
  <style>
    :root {

      /* Brand */
      --primary: <%= settings.primaryColor %>;
      --secondary: <%= settings.secondaryColor %>;

      /* Backgrounds */
      --background: <%= settings.backgroundColor %>;
      --surface: <%= settings.surfaceColor %>;
      --surfaceAlt: <%= settings.surfaceAltColor %>;

      /* Text */
      --heading: <%= settings.headingColor %>;
      --text: <%= settings.textColor %>;
      --muted: <%= settings.mutedTextColor %>;
      --interaction: <%= settings.interactionColor %>;

      /* Border */
      --border: <%= settings.borderColor %>;

    }
  </style>
</head>
<body>

<header class="header">
      <a href="/">
        <div class="logo">
          <%= settings.siteName || "MyStore" %>
        </div>
      </a>
  <nav>
    <a href="/">Home</a>
    
    <a href="/dashboard">Dashboard</a>
  </nav>
</header>

<main class="cart-container">
  <h1>Your Shopping Cart</h1>

  <div id="cartItems"></div>

  <!-- Cart Summary & Checkout -->
  <div class="cart-summary">
    <h3>Order Summary</h3>
    <p>Total Items: <span id="totalItems">0</span></p>
    <p>Total Price: <strong><%= settings.currencySymbol || "GH₵" %><span id="totalPrice">0.00</span></strong></p>
    <p>Shipping Fee: <strong><%= settings.currencySymbol || "GH₵" %><span id="shippingFee">0.00</span></strong></p>

    <!-- Default shipping address -->
    <div class="shipping-address">
      <h4>Shipping Address</h4>
      <div id="defaultAddress"></div>
      <a href="/dashboard"><button id="changeAddressBtn">Change / Add New</button></a>
    </div>

    <!-- Payment method -->
    <div class="payment-method">
    <h4>Payment Method</h4>

    <div id="paymentMethods">
      <% if (settings.enablePaystack) { %>
        <label>
          <input type="radio" name="payment" value="paystack">
          Mobile Money / Card (Paystack)
        </label>
        <br>
      <% } %>

      <% if (settings.enableStripe) { %>
        <label>
          <input type="radio" name="payment" value="stripe">
          Card Payment (Stripe)
        </label>
        <br>
      <% } %>

      <% if (!settings.enablePaystack && !settings.enableStripe) { %>
        <p>No online payment methods are currently available.</p>
      <% } %>
    </div>
  </div>

    <!-- Delivery & Security Info -->
    <div class="delivery-info">
      <p>🚚 Delivery Guarantee: Your order will arrive on time.</p>
      <p>💳 Card Protection: Payments are securely processed.</p>
      <p>🔒 Privacy: Your data is safe with us.</p>
    </div>

    <button class="checkout-btn">Proceed to Checkout</button>
  </div>
</main>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-container">

    <!-- BRAND -->
    <div class="footer-section">
      <h3><%= settings?.siteName || "MyStore" %></h3>
      <p><%= settings?.footerText || "Your one-stop shop for everything." %></p>
    </div>

    <!-- CONTACT -->
    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: <%= settings?.contactEmail || "support@email.com" %></p>
      <p>Phone: <%= settings?.contactPhone || "+233..." %></p>
    </div>

    <!-- LINKS -->
    <div class="footer-section">
      <h4>Quick Links</h4>
      <a href="/">Home</a>
      <a href="/cart">Cart</a>
      <a href="/dashboard">Account</a>
    </div>

  </div>

  <div class="footer-bottom">
    © <%= new Date().getFullYear() %> 
    <%= settings?.siteName || "MyStore" %> — All rights reserved.
  </div>
</footer>

<!-- Scripts -->
<script>window.STORE_CURRENCY_SYMBOL = <%- JSON.stringify(settings.currencySymbol || "GH₵") %>;</script>
<script src="/js/cart.js"></script>
<script src="/js/cartBadge.js"></script>

</body>
</html>